#!/usr/bin/env python3

import argparse
import subprocess
import sys
from collections import OrderedDict


def run_git_diff(base_ref: str):
    cmd = ["git", "diff", "--name-status", f"{base_ref}...HEAD"]
    result = subprocess.run(cmd, capture_output=True, text=True)

    if result.returncode != 0:
        print(result.stderr.strip(), file=sys.stderr)
        sys.exit(result.returncode)

    return result.stdout.splitlines()


def normalize_status(status: str) -> str:
    if status.startswith("R"):
        return "R"
    if status.startswith("C"):
        return "C"
    return status


def insert_path(tree, path_parts, status, extra=None):
    cur = tree
    for part in path_parts[:-1]:
        cur = cur.setdefault(part, OrderedDict())

    cur[path_parts[-1]] = {
        "__status__": status,
        "__extra__": extra,
    }


def build_tree(lines):
    tree = OrderedDict()

    for line in lines:
        if not line.strip():
            continue

        parts = line.split("\t")
        raw_status = parts[0]
        status = normalize_status(raw_status)

        if status in {"R", "C"}:
            if len(parts) < 3:
                continue
            old_path, new_path = parts[1], parts[2]
            insert_path(
                tree,
                new_path.split("/"),
                status,
                f"{old_path} -> {new_path}",
            )
        else:
            if len(parts) < 2:
                continue
            insert_path(tree, parts[1].split("/"), status)

    return tree


def sort_items(node):
    return sorted(node.items(), key=lambda item: item[0].lower())


def print_checklist(node, indent=0):
    for name, child in sort_items(node):
        if "__status__" in child:
            status = child["__status__"]
            extra = child["__extra__"]
            suffix = f" - {extra}" if extra else ""
            print("  " * indent + f"- [ ] [{status}] {name}{suffix}")
        else:
            print("  " * indent + f"- [ ] {name}/")
            print_checklist(child, indent + 1)


def print_tree(node, prefix=""):
    items = sort_items(node)

    for index, (name, child) in enumerate(items):
        is_last = index == len(items) - 1
        branch = "└── " if is_last else "├── "
        next_prefix = prefix + ("    " if is_last else "│   ")

        if "__status__" in child:
            status = child["__status__"]
            extra = child["__extra__"]
            suffix = f" - {extra}" if extra else ""
            print(f"{prefix}{branch}[{status}] {name}{suffix}")
        else:
            print(f"{prefix}{branch}{name}/")
            print_tree(child, next_prefix)


def parse_args():
    parser = argparse.ArgumentParser(
        description="Show changed files since a base ref in tree or checklist format."
    )
    parser.add_argument(
        "base_ref",
        nargs="?",
        default="origin/main",
        help="Base ref to compare against (default: origin/main)",
    )
    parser.add_argument(
        "--format",
        choices=["tree", "checklist"],
        default="checklist",
        help="Output format (default: checklist)",
    )
    return parser.parse_args()


def main():
    args = parse_args()
    lines = run_git_diff(args.base_ref)
    tree = build_tree(lines)

    if args.format == "tree":
        print_tree(tree)
    else:
        print_checklist(tree)


if __name__ == "__main__":
    main()
