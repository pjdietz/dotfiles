#!/usr/bin/env python3

import argparse
import subprocess
import sys
from collections import OrderedDict


RESET = "\033[0m"
STATUS_COLORS = {
    "A": "\033[32m",
    "M": "\033[33m",
    "R": "\033[33m",
    "D": "\033[31m",
}


def run_git_diff(refs, cached: bool):
    cmd = ["git", "diff", "--name-status"]

    if cached:
        cmd.append("--cached")

    cmd.extend(refs)
    result = subprocess.run(cmd, capture_output=True, text=True)

    if result.returncode != 0:
        print(result.stderr.strip(), file=sys.stderr)
        sys.exit(result.returncode)

    return result.stdout.splitlines()


def normalize_status(status: str) -> str:
    if status.startswith("R"):
        return "R"
    if status.startswith("C"):
        return "C"
    return status


def insert_path(tree, path_parts, status, extra=None):
    cur = tree
    for part in path_parts[:-1]:
        cur = cur.setdefault(part, OrderedDict())

    cur[path_parts[-1]] = {
        "__status__": status,
        "__extra__": extra,
    }


def build_tree(lines):
    tree = OrderedDict()

    for line in lines:
        if not line.strip():
            continue

        parts = line.split("\t")
        raw_status = parts[0]
        status = normalize_status(raw_status)

        if status in {"R", "C"}:
            if len(parts) < 3:
                continue
            old_path, new_path = parts[1], parts[2]
            insert_path(
                tree,
                new_path.split("/"),
                status,
                f"{old_path} -> {new_path}",
            )
        else:
            if len(parts) < 2:
                continue
            insert_path(tree, parts[1].split("/"), status)

    return tree


def sort_items(node):
    return sorted(node.items(), key=lambda item: item[0].lower())


def supports_color(no_color: bool) -> bool:
    return sys.stdout.isatty() and not no_color


def format_entry(status: str, name: str, no_color: bool, extra=None) -> str:
    suffix = f" - {extra}" if extra else ""
    entry = f"[{status}] {name}{suffix}"

    if not supports_color(no_color):
        return entry

    color = STATUS_COLORS.get(status)
    if not color:
        return entry

    return f"{color}{entry}{RESET}"


def print_tree(node, no_color: bool, prefix=""):
    items = sort_items(node)

    for index, (name, child) in enumerate(items):
        is_last = index == len(items) - 1
        branch = "└── " if is_last else "├── "
        next_prefix = prefix + ("    " if is_last else "│   ")

        if "__status__" in child:
            status = child["__status__"]
            extra = child["__extra__"]
            print(f"{prefix}{branch}{format_entry(status, name, no_color, extra)}")
        else:
            print(f"{prefix}{branch}{name}/")
            print_tree(child, no_color, next_prefix)


def parse_args():
    parser = argparse.ArgumentParser(
        description="Show changed files from git diff in tree format."
    )
    parser.add_argument(
        "refs",
        nargs="*",
        help="Git refs to diff, like git diff [ref1] [ref2]",
    )
    parser.add_argument(
        "--no-color",
        action="store_true",
        help="Disable colored output",
    )
    parser.add_argument(
        "--cached",
        action="store_true",
        help="Show staged changes",
    )

    args = parser.parse_args()

    if len(args.refs) > 2:
        parser.error("expected at most two refs")

    if args.cached and len(args.refs) == 2:
        parser.error("--cached supports at most one ref")

    return args


def main():
    args = parse_args()
    lines = run_git_diff(args.refs, args.cached)
    tree = build_tree(lines)
    print_tree(tree, args.no_color)


if __name__ == "__main__":
    main()
