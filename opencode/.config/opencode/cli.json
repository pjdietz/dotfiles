{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin"
  },
  "keybinds": {
    "leader": "ctrl+x",
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab",
    "prompt.autocomplete.next": "ctrl+n",
    "prompt.autocomplete.prev": "ctrl+p",
    "prompt.autocomplete.select": "return,ctrl+y",
    "prompt.autocomplete.complete": "none",
    "session.page.up": "ctrl+u",
    "session.page.down": "ctrl+d",
    "input.submit": "ctrl+return",
    "input.newline": "shift+return,return,alt+return"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "tabs": {
    "mode": "off"
  },
  "animations": true
}
